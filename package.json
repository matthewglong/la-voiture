{
  "name": "la-voiture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "balance": "tsx scripts/balance.ts",
    "balance:race": "tsx scripts/balanceRace.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "tsc --noEmit && tsx scripts/smoke.ts && tsx scripts/balance.ts > /dev/null && echo 'check: typecheck, smoke and balance pass'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
